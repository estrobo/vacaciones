# .env.example - Configuración del sistema de gestión de vacaciones
# Copia este archivo y completa los valores según tu entorno
# También puedes usar el archivo backend/.env existente como referencia

# Configuración de base de datos
DB_DIALECT=sqlite        # Puede ser: sqlite (desarrollo) o mysql (producción)
DB_NAME=vacation_system  # Nombre de la base de datos
DB_USER=root             # Usuario de la base de datos
DB_PASSWORD=             # Contraseña de la base de datos
DB_HOST=localhost        # Host de la base de datos

# Configuración JWT
JWT_SECRET=cambia_esta_clave_secreta_en_produccion  # Cambia esto por una clave segura en producción
JWT_EXPIRES=8h          # Tiempo de expiración del token

# Configuración de correo
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=notificahevico@gmail.com
EMAIL_PASSWORD=

# Configuración general
PORT=3000
EMPRESA_NOMBRE=Mi Empresa